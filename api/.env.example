# Copy to .env and change what you need. Never commit .env.
SHELF_ENVIRONMENT=development
SHELF_DATABASE_URL=sqlite:///./shelf.db
# Any long random string. In production the dev default is refused.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SHELF_API_KEY=dev-key-change-me
SHELF_LOG_LEVEL=INFO
